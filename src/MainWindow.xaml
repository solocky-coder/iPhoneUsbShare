<Window x:Class="iPhoneUsbShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone USB Transport"
        Width="620" Height="560"
        MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="iPhone USB Transport" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Prepare the iPhone USB/NCM network path for SonoBus and the DAW"
                       FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                Padding="18" Margin="0,22,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Apple device" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="PhoneText" Text="Looking for iPhone or iPad…" FontSize="18"
                               FontWeight="Medium" Margin="0,3,0,0"/>
                    <TextBlock x:Name="AdapterText" Text="USB NCM Ethernet: not connected"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Ellipse x:Name="StatusDot" Grid.Column="1" Width="16" Height="16"
                         Fill="{StaticResource Warn}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Transport" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="StateText" Text="USB transport not ready" FontSize="20"
                               FontWeight="SemiBold" Margin="0,3,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IPv4" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="IpText" Text="—" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Receive" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="RxText" Text="0 KB/s" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Transmit" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxText" Text="0 KB/s" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Activity" FontSize="13" Foreground="{StaticResource Muted}"/>
                    <ScrollViewer Height="105" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="StartButton" Content="Start USB transport" Click="StartButton_Click"
                    Background="{StaticResource Accent}" Foreground="White"/>
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
            <Button Content="Diagnostics" Click="DiagnosticsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
