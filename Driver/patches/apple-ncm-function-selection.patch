@@ -194,8 +194,17 @@ NTSTATUS UsbNcmHostDevice::RetrieveConfiguration()
-    BYTE controlInterfaceNumber = 0;
-    BYTE dataInterfaceNumber = 0;
+    // iOS 16+ can expose more than one CDC-NCM function. The first one is
+    // the tethering function and has a CDC interrupt endpoint; the later
+    // RemoteXPC function does not. The CDC Union descriptor is authoritative.
+    BYTE controlInterfaceNumber = 0xff;
+    BYTE dataInterfaceNumber = 0xff;
+    BYTE unionDataInterfaceNumber = 0xff;
+    BOOLEAN selectedNcmFunction = FALSE;
@@ -218,21 +227,20 @@ NTSTATUS UsbNcmHostDevice::RetrieveConfiguration()
                 if ((pIfDescriptor->bInterfaceClass == USB_CDC_INTERFACE_CLASS_COMM) &&
